{
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "install-deps": "npm ci --omit=dev",
    "smoke-test": "node ../scripts/smoke-test.js",
    "test:workflows": "node --test tests/*workflows.test.js",
    "test:integration": "node tests/integration-workflows.js",
    "test:browser": "RUN_BROWSER_TESTS=1 node tests/integration-workflows.js",
    "backfill:booking-codes": "node scripts/backfill-booking-codes.js",
    "report:legacy-passwords": "node scripts/legacy-password-report.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "multer": "^2.0.2",
    "node-cron": "^3.0.2"
  },
  "devDependencies": {
    "mongodb-memory-server": "^8.12.1",
    "nodemon": "^3.0.2"
  },
  "overrides": {
    "qs": "^6.16.2",
    "uuid": "^11.1.1"
  }
}
