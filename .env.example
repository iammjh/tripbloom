# MongoDB Connection
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/tripbloom?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here

# Node Environment
NODE_ENV=production

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Server Port
PORT=5000

# Optional Settings
HOME_COUNTRY=Bangladesh
MAX_FILE_SIZE=5242880

# Customer AI assistant (optional feature). The key is read by the backend only and never sent to the browser.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: the Claude model used for assistant answers.
ASSISTANT_MODEL=claude-sonnet-5-5

# Groq (free tier). Set ASSISTANT_PROVIDER=groq to use it even when ANTHROPIC_API_KEY is also set.
GROQ_API_KEY=your_groq_api_key_here
# ASSISTANT_PROVIDER=groq
# Optional: the Groq model id (check the current list at console.groq.com).
# ASSISTANT_MODEL=openai/gpt-oss-120b
